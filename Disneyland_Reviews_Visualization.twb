          <datasource-dependencies datasource='federated.0pzh2fp1fqbms31fetgt915tf7qo'>
            <column caption='Month' datatype='integer' name='[Month (date) (Months)]' role='dimension' type='ordinal' user:agg-type='Month' user:base-field='Month (date)' user:ui-builder='date-bin-builder'>
